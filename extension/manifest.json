{
  "manifest_version": 3,
  "name": "TrustLens AI — Smart Web Trust Engine",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Understand observable website risk signals with local-first page inspection.",
  "icons": {
    "16": "icons/trustlens-16.png",
    "32": "icons/trustlens-32.png",
    "48": "icons/trustlens-48.png",
    "128": "icons/trustlens-128.png"
  },
  "action": {
    "default_title": "TrustLens AI",
    "default_icon": {
      "16": "icons/trustlens-16.png",
      "32": "icons/trustlens-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
